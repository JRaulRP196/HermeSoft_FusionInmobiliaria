
@{
    ViewBag.Title = "Error500";
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<div class="auth-error d-flex align-items-center min-vh-100">
    <div class="bg-overlay bg-light"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-8">
                <div>
                    <div class="text-center mb-4">
                        <div class="mt-5">
                            <h1 class="error-title mt-5"><span>ERROR</span></h1>
                            <h4 class="mt-2 text-uppercase mt-4">Muchos intentos de inicio de sesión</h4>
                            <p class="mt-4 text-muted w-50 mx-auto">Realizaste muchos intentos fallidos de inicio de sesión, favor espera 5 minutos</p>
                        </div>

                        <div class="mt-5 text-center">
                            <a class="btn btn-primary waves-effect waves-light" asp-controller="Auth" asp-action="Login">Volver al Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{

    <script src="~/assets/js/app.js"></script>
}
